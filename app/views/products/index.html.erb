<h1>Products</h1>

<div id="products">
  <% @products.each do |product| %>
    <%= link_to product, class: "product-card" do %>
      <% if product.featured_image.attached? %>
        <%= image_tag product.featured_image.variant(resize_to_fill: [ 400, 400 ]), alt: "", class: "product-card__image" %>
      <% else %>
        <div class="product-card__image product-card__placeholder">No image</div>
      <% end %>
      <div class="product-card__name"><%= product.name %></div>
      <% if product.description.present? %>
        <p class="product-card__description"><%= product.description.to_plain_text.squish.truncate(100, separator: " ") %></p>
      <% end %>
    <% end %>
  <% end %>
</div>
